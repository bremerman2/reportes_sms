<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${tituloPagina}" /> · AlertaSMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800&display=swap"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/estilos/alertasms.css">
</head>
<body>
<div class="as-app">

    <header class="as-encabezado">
        <a class="as-marca" href="${ctx}/inicio">
            AlertaSMS<span>Administración</span>
        </a>

        <div class="as-sesion">
            <span>
                Administrador:
                <strong><c:out value="${sessionScope.adminLogueado.nombre}" /></strong>
            </span>
            <a class="as-link-rojo" href="${ctx}/logout">Cerrar sesión</a>
        </div>
    </header>

    <div class="as-cuerpo">

        <nav class="as-menu" id="menu" aria-label="Menú de administración">
            <p class="as-menu-titulo">Administración</p>

            <button class="as-menu-boton"
                    type="button"
                    aria-expanded="false"
                    aria-controls="menu-lista">
                Menú <em><c:out value="${tituloPagina}" /> ▾</em>
            </button>

            <ul id="menu-lista">
                <li>
                    <a href="${ctx}/inicio"
                       ${menuActivo == 'inicio' ? 'aria-current="page"' : ''}>
                        Inicio
                    </a>
                </li>
                <li>
                    <a href="${ctx}/reportes"
                       ${menuActivo == 'reportes' ? 'aria-current="page"' : ''}>
                        Reportes SMS
                    </a>
                </li>
                <li>
                    <a href="${ctx}/numeros-oficiales"
                       ${menuActivo == 'numeros' ? 'aria-current="page"' : ''}>
                        Números oficiales
                    </a>
                </li>
                <li>
                    <a href="${ctx}/prefijos"
                       ${menuActivo == 'prefijos' ? 'aria-current="page"' : ''}>
                        Prefijos de países
                    </a>
                </li>
                <li>
                    <a href="${ctx}/usuarios"
                       ${menuActivo == 'usuarios' ? 'aria-current="page"' : ''}>
                        Usuarios
                    </a>
                </li>
                <li>
                    <a href="${ctx}/administradores"
                       ${menuActivo == 'administradores' ? 'aria-current="page"' : ''}>
                        Administradores
                    </a>
                </li>
            </ul>
        </nav>

        <main class="as-contenido">

            <c:if test="${not empty sessionScope.mensajeExito}">
                <div class="as-aviso as-aviso-exito" role="status">
                    <c:out value="${sessionScope.mensajeExito}" />
                </div>
                <c:remove var="mensajeExito" scope="session" />
            </c:if>

            <c:if test="${not empty sessionScope.mensajeError}">
                <div class="as-aviso as-aviso-error" role="alert">
                    <c:out value="${sessionScope.mensajeError}" />
                </div>
                <c:remove var="mensajeError" scope="session" />
            </c:if>
