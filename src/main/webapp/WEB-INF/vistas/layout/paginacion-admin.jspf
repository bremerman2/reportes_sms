<%@ page pageEncoding="UTF-8" %>
<%--
  Barra de paginación de los listados de administración (Bootstrap).
  Usa lo que deja Paginacion.calcular(...) en el request; los links conservan búsqueda y filtros.
--%>
<c:if test="${totalRegistros > 0}">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mt-3">
        <span class="text-body-secondary small">Página ${paginaActual} de ${totalPaginas} · ${desdeRegistro}–${hastaRegistro} de ${totalRegistros}</span>
        <div class="d-flex gap-2">
            <c:choose>
                <c:when test="${paginaActual > 1}"><a class="btn btn-outline-secondary btn-sm" href="<c:out value='${urlPagina}${paginaActual - 1}' />">&larr; Anterior</a></c:when>
                <c:otherwise><span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">&larr; Anterior</span></c:otherwise>
            </c:choose>
            <c:choose>
                <c:when test="${paginaActual < totalPaginas}"><a class="btn btn-outline-secondary btn-sm" href="<c:out value='${urlPagina}${paginaActual + 1}' />">Siguiente &rarr;</a></c:when>
                <c:otherwise><span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Siguiente &rarr;</span></c:otherwise>
            </c:choose>
        </div>
    </div>
</c:if>
