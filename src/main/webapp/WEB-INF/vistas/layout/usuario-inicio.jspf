<%--
  Parte de arriba del panel de usuario (AlertaSMS v2).
  Antes de incluirlo, cada página define:
    <c:set var="tituloPagina" value="..." />
    <c:set var="menuActivo"  value="inicio | reportar | misReportes | comunidad | perfil" />
  Se cierra con layout/usuario-fin.jspf
--%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ page import="org.example.NotificacionDAO" %>
<%@ page import="org.example.Usuario" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<%
    //Contar las notificaciones no leidas
    Usuario user = (Usuario) session.getAttribute("usuarioLogueado");
    int cantNotificaciones = 0;
    if (user != null) {
        NotificacionDAO ndao = new NotificacionDAO();
        cantNotificaciones = ndao.contarNoLeidas(user.getId_usuario());
    }
    request.setAttribute("cantNotificaciones", cantNotificaciones);
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${tituloPagina}" /> · AlertaSMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/estilos/alertasms.css?v=${applicationScope.versionEstilos}">
</head>
<body>
<div class="as-app">

    <%-- 1 · Encabezado --%>
    <header class="as-encabezado">
        <a class="as-marca" href="${ctx}/inicio">AlertaSMS<span>Mi cuenta</span></a>
        <div class="as-sesion">
            <%-- Notificaciones --%>
            <a href="${ctx}/notificaciones" title="Notificaciones" aria-label="Notificaciones"
               class="as-nav-notificaciones" ${menuActivo == 'notificaciones' ? 'aria-current="page"' : ''}>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-bell" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4 4 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4 4 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6a5 5 0 0 1 10 0c0 .88.32 4.2 1.22 6z"/>
                </svg>
                <c:if test="${cantNotificaciones > 0}">
                    <span class="as-badge-notificacion">${cantNotificaciones}</span>
                </c:if>
            </a>

            <%-- Iniciales del usuario: abren un menú flotante con Mi perfil y Cerrar sesión (el script está en usuario-fin.jspf) --%>
            <div class="as-cuenta" id="menu-cuenta">
                <button type="button" class="as-avatar" aria-haspopup="true" aria-expanded="false" aria-controls="menu-cuenta-lista"
                        title="Mi cuenta (${fn:escapeXml(sessionScope.usuarioLogueado.nombre)} ${fn:escapeXml(sessionScope.usuarioLogueado.apellido)})">
                    <c:out value="${fn:toUpperCase(fn:substring(sessionScope.usuarioLogueado.nombre, 0, 1))}${fn:toUpperCase(fn:substring(sessionScope.usuarioLogueado.apellido, 0, 1))}" />
                </button>
                <div class="as-cuenta-menu" id="menu-cuenta-lista" hidden>
                    <p class="as-cuenta-nombre">
                        <strong><c:out value="${sessionScope.usuarioLogueado.nombre} ${sessionScope.usuarioLogueado.apellido}" /></strong>
                        <span><c:out value="${sessionScope.usuarioLogueado.email}" /></span>
                    </p>
                    <a href="${ctx}/perfil" ${menuActivo == 'perfil' ? 'aria-current="page"' : ''}>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
                        Mi perfil
                    </a>
                    <a href="${ctx}/logout-usuario" class="as-cuenta-salir">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
                        Cerrar sesión
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="as-cuerpo">

        <%-- 2 · Menú (en pantallas chicas se pliega en un botón) --%>
        <nav class="as-menu" id="menu" aria-label="Menú principal">
            <p class="as-menu-titulo">Menú</p>
            <button class="as-menu-boton" type="button" aria-expanded="false" aria-controls="menu-lista">
                Menú <em><c:out value="${tituloPagina}" /> ▾</em>
            </button>
            <ul id="menu-lista">
                <li><a href="${ctx}/inicio" ${menuActivo == 'inicio' ? 'aria-current="page"' : ''}>Inicio</a></li>
                <li><a href="${ctx}/reportar" ${menuActivo == 'reportar' ? 'aria-current="page"' : ''}>Reportar SMS</a></li>
                <li><a href="${ctx}/mis-reportes" ${menuActivo == 'misReportes' ? 'aria-current="page"' : ''}>Mis reportes</a></li>
                <li><a href="${ctx}/comunidad" ${menuActivo == 'comunidad' ? 'aria-current="page"' : ''}>Comunidad</a></li>
                <li><a href="${ctx}/consulta-prefijos" ${menuActivo == 'prefijosPublicos' ? 'aria-current="page"' : ''}>Prefijos de países</a></li>
                <li><a href="${ctx}/consulta-numeros-oficiales" ${menuActivo == 'numerosPublicos' ? 'aria-current="page"' : ''}>Números oficiales</a></li>
                <li><a href="${ctx}/perfil" ${menuActivo == 'perfil' ? 'aria-current="page"' : ''}>Mis datos</a></li>

            </ul>
        </nav>

        <main class="as-contenido">

            <%-- Mensajes que dejan los servlets antes del redirect (se muestran una sola vez) --%>
            <c:if test="${not empty sessionScope.mensajeExito}">
            <div class="as-aviso as-aviso-exito" role="status"><c:out value="${sessionScope.mensajeExito}" /></div>
                <c:remove var="mensajeExito" scope="session" />
            </c:if>
            <c:if test="${not empty sessionScope.mensajeError}">
            <div class="as-aviso as-aviso-error" role="alert"><c:out value="${sessionScope.mensajeError}" /></div>
                <c:remove var="mensajeError" scope="session" />
            </c:if>
